# Copy to server/.env for local runs; on Render set these in the dashboard.
# Without any mail settings, local dev prints the login code to the console.
# On Render's free plan SMTP is blocked — use MAIL_RELAY_URL (Vercel) or BREVO_API_KEY there.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Deep Sea <you@gmail.com>"
HOST_EMAILS=you@gmail.com
SESSION_SECRET=
